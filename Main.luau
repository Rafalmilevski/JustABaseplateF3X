	["R"] = "Rotation",
	["Z"] = "ZIndex",
	["LO"] = "LayoutOrder"
}

local function Create(class,props,parent)

	local obj = Instance.new(class)

	for k,v in pairs(props) do
		local property = Alias[k] or k

		pcall(function()
			obj[property] = v
		end)
	end

	obj.Parent = parent

	return obj
end

