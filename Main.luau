----------------------------------------------------------------
--// LOAD
----------------------------------------------------------------

local function Load()

	print("Loading F3X...")

	print("HTTP Enabled:",
		HttpService.HttpEnabled)


	------------------------------------------------------------
	-- HTTP WARNING
	------------------------------------------------------------

	if not HttpService.HttpEnabled then

		print("HTTP Service Disabled")

		local Template =
			Notifications.Template:Clone()

		Template.Name =
			"HTTPEnabledNotification"

		Template.Text.Text =
			"HTTP requests must be <b>enabled</b> for some features of Building Tools to work, including exporting."

		Template.Visible = true

		Template.Parent =
			Notifications


		Template.OKButton.MouseButton1Click:Connect(function()

			Template:Destroy()

		end)


		Template.DetailsButton.MouseButton1Click:Connect(function()

			Template.Text.Text = [[
Own this place? Edit it in Studio, and toggle on
HOME > <b>Game Settings</b> > Security > <b>Allow HTTP Requests</b> :-)
]]

			Template.DetailsButton:Destroy()

		end)

	end


	------------------------------------------------------------
	-- DEFAULT TOOL
	------------------------------------------------------------

	SelectTool("Move")

end


----------------------------------------------------------------
--// EQUIPPED
----------------------------------------------------------------

Tool.Equipped:Connect(function()

	GUI.Enabled = true

	-- Show current selection
	if SelectedPart then
		Selection.Adornee = SelectedPart
		Handles.Adornee = SelectedPart
	end


	if not loaded then

		Load()

		loaded = true

	end

end)


----------------------------------------------------------------
--// UNEQUIPPED
----------------------------------------------------------------

Tool.Unequipped:Connect(function()

	GUI.Enabled = false

	-- Hide selection
	Selection.Adornee = nil
	Handles.Adornee = nil

	Dragging = false
	DragStartCFrame = nil

end)


----------------------------------------------------------------
--// CLEANUP IF SELECTED PART IS DESTROYED
----------------------------------------------------------------

game:GetService("RunService").Heartbeat:Connect(function()

	if SelectedPart then

		if not SelectedPart.Parent then

			ClearSelection()

		end

	end

end)


