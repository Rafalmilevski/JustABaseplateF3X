Handles.Name = "F3XHandles"

-- Default tool is Move
Handles.Style = Enum.HandlesStyle.Movement

Handles.Color3 = Color3.fromRGB(255, 170, 0)
Handles.Transparency = 0

Handles.Adornee = nil
Handles.Parent = GUI


----------------------------------------------------------------
--// SELECT PART
----------------------------------------------------------------

local function SelectPart(part)

	if not part then
		return
	end

	if not part:IsA("BasePart") then
		return
	end

	SelectedPart = part

	Selection.Adornee = part
	Handles.Adornee = part

	print("Selected:", part:GetFullName())
end


----------------------------------------------------------------
--// CLEAR SELECTION
----------------------------------------------------------------

local function ClearSelection()

	SelectedPart = nil

	Selection.Adornee = nil
	Handles.Adornee = nil

	Dragging = false
	DragStartCFrame = nil
end


----------------------------------------------------------------
--// CLICK PART TO SELECT
----------------------------------------------------------------

Mouse.Button1Down:Connect(function()

	-- Don't select a part when clicking the Handles themselves
	if Handles.Adornee then
		-- Roblox handles handle their own mouse interaction
	end

	local Target = Mouse.Target

	if Target and Target:IsA("BasePart") then
		SelectPart(Target)
	end
end)


----------------------------------------------------------------
--// MOVE HANDLES
----------------------------------------------------------------

Handles.MouseButton1Down:Connect(function()

	if not SelectedPart then
		return
	end

	Dragging = true

	-- Save the position BEFORE the drag starts
	DragStartCFrame = SelectedPart.CFrame

end)


Handles.MouseDrag:Connect(function(face, distance)

	if not Dragging then
		return
	end

	if not SelectedPart then
		return
	end

	if not DragStartCFrame then
		return
	end

	-- Convert the selected handle face into a direction
	local direction = Vector3.FromNormalId(face)

	-- MouseDrag distance is relative to the beginning
	-- of the current drag.
	local offset = direction * distance

	-- IMPORTANT:
	-- Don't add to the current CFrame.
	-- Always calculate from DragStartCFrame.
	SelectedPart.CFrame = DragStartCFrame + offset

end)


Handles.MouseButton1Up:Connect(function()

	Dragging = false
	DragStartCFrame = nil

end)


----------------------------------------------------------------
--// TOOL GUI
----------------------------------------------------------------

local function ShowToolGUI(frameName)

	for _, object in ipairs(GUI:GetChildren()) do

		if object:IsA("Frame") then

			if object.Name == "Dock" then

				-- Dock always remains visible
				object.Visible = true

			elseif object.Name == frameName then

				object.Visible = true

			else

				object.Visible = false

			end
		end
	end
end


